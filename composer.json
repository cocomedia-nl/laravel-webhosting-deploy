{
	"name": "cocomedia-nl/laravel-webhosting-deploy",
	"description": "Laravel package for automated shared webhosting deployment (DirectAdmin and TransIP) with GitHub Actions support",
	"type": "library",
	"version": "0.2.0",
	"license": "MIT",
	"keywords": [
		"laravel",
		"webhosting",
		"directadmin",
		"transip",
		"deployment",
		"github-actions",
		"ssh"
	],
	"authors": [
		{
			"name": "Cocomedia",
			"email": "info@cocomedia.nl"
		}
	],
	"require": {
		"php": "^8.2",
		"illuminate/console": "^11.0|^12.0|^13.0",
		"illuminate/process": "^11.0|^12.0|^13.0",
		"illuminate/support": "^11.0|^12.0|^13.0",
		"laravel/prompts": "^0.1.25 || ^0.2 || ^0.3",
		"symfony/console": "^7.0"
	},
	"require-dev": {
		"orchestra/testbench": "^8.0|^9.0|^10.0",
		"phpunit/phpunit": "^12.5.23"
	},
	"autoload": {
		"psr-4": {
			"CocomediaNL\\LaravelWebhostingDeploy\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CocomediaNL\\LaravelWebhostingDeploy\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"CocomediaNL\\LaravelWebhostingDeploy\\WebhostingDeployServiceProvider"
			]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"sort-packages": true
	}
}
